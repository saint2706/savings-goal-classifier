# IHDS-II derived microdata — NOT redistributable.
# ICPSR study 36151 terms of use: "You agree not to redistribute data or other
# materials without the written agreement of ICPSR." These files are household-level
# records derived from that study, so they must not be committed to a public repo.
# Reproduce them by downloading DS0002 from https://www.icpsr.umich.edu/web/DSDR/studies/36151
# (free, registration required) and running:
#   uv run sgc build --tsv <path>/36151-0002-Data.tsv
dataset/households.csv
dataset/features.csv

# Raw ICPSR download and any derived household-level files (same redistribution terms).
dataset/*.tsv
dataset/*.parquet
36151-*

# Fitted models are derived from the microdata; rebuild with `uv run sgc train`.
artifacts/

