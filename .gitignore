# --- Restricted and third-party data: never committed ------------------------
# IHDS-II (ICPSR study 36151): "You agree not to redistribute data or other
# materials without the written agreement of ICPSR." Everything below is the raw
# download or a household-level file derived from it. Reproduce it by downloading
# DS0002 from https://www.icpsr.umich.edu/web/DSDR/studies/36151 (free,
# registration required) and running:
#   uv run sgc build --tsv <path>/36151-0002-Data.tsv
dataset/ICPSR_36151/
dataset/*.tsv
dataset/*.csv
dataset/*.parquet
36151-*

# HCES 2022-23 level files (third-party clean dump of public NSS microdata, used
# only for the external-validity check; see dataset/README.md).
dataset/hces/

# Fitted models are derived from the microdata; rebuild with `uv run sgc train`.
artifacts/

# Output of `sgc demo` (synthetic data).
demo_out/

# Private working notes.
feedback/

